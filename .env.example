# ── Apply-Agent Environment Variables ───────────────────────────────────────
# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# ── LLM Provider ─────────────────────────────────────────────────────────────
# "local"    → load Qwen 2.5 LoRA model from disk (CUDA GPU required)
# "external" → proxy to any OpenAI-compatible REST API (no GPU needed)
LLM_PROVIDER=local

# ── External API Settings (only used when LLM_PROVIDER=external) ─────────────
# Set these to your provider's values. Works with OpenRouter, Groq, OpenAI, etc.
EXTERNAL_API_BASE_URL=https://openrouter.ai/api/v1
EXTERNAL_API_KEY=
EXTERNAL_API_MODEL=openai/gpt-4o-mini
EXTERNAL_API_TIMEOUT=120

# ── Local Model Optimisations (only used when LLM_PROVIDER=local) ────────────
# Enable 4-bit BitsAndBytes quantization (needs bitsandbytes>=0.43 + CUDA GPU).
# Reduces VRAM from ~3.5 GB to ~1.2 GB for Qwen 2.5 1.5B.
LLM_QUANTIZE_4BIT=true
# Max tokens generated per request (256 was too short for full CVs).
LLM_MAX_NEW_TOKENS=1024
# torch.compile: ~20% faster after a warm-up call, but adds ~30 s first-run overhead.
LLM_USE_TORCH_COMPILE=false

# ── RAG Tuning ────────────────────────────────────────────────────────────────
# Number of past accepted jobs injected as few-shot examples into prompts.
RAG_FEW_SHOT_LIMIT=3
# Max characters per example snippet injected into the prompt.
RAG_EXAMPLE_MAX_CHARS=800

# ── HuggingFace Token (for gated model downloads) ─────────────────────────────
HF_TOKEN=

# ── SonarQube (CI only) ───────────────────────────────────────────────────────
SONARQ_TOKEN=
